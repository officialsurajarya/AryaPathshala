{
  "name": "aryapathshala-workspace",
  "version": "1.0.0",
  "private": true,
  "main": "server/src/server.js",
  "description": "Arya Pathshala - Vedic & Sanskrit Educational Portal (Monorepo Workspace)",
  "scripts": {
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "preclient:build": "chmod +x client/node_modules/.bin/* 2>/dev/null || true",
    "build": "npm run client:build",
    "start": "npm start --prefix server",
    "client": "npm start --prefix client",
    "server": "npm run dev --prefix server",
    "client:start": "npm start --prefix client",
    "client:build": "npm run build --prefix client",
    "client:test": "npm test --prefix client",
    "server:start": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "install:client": "npm install --prefix client",
    "install:server": "npm install --prefix server",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server",
    "prisma:studio": "npm run prisma:studio --prefix server"
  },
  "keywords": [
    "arya-pathshala",
    "react",
    "express",
    "prisma",
    "mysql",
    "sanskrit",
    "vedic"
  ],
  "author": "Arya Pathshala Team"
}
