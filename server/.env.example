# Arya Pathshala Backend Configuration
# Compatible with Local MySQL and Hostinger MySQL / MariaDB

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database URL for MySQL / MariaDB
# Hostinger Format: mysql://<uXXXXXXXX_dbuser>:<Password>@127.0.0.1:3306/<uXXXXXXXX_dbname>
# Local Format: mysql://root:password@localhost:3306/aryapathshala
DATABASE_URL="mysql://root:root@localhost:3306/aryapathshala"

# JWT Authentication
JWT_SECRET="arya-pathshala-secure-jwt-secret-key-production-replace-this"
JWT_EXPIRE="7d"

# SMTP / Email Configuration for notifications & password reset
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="officialaryapathshala@gmail.com"
EMAIL_PASS="your-app-specific-password"
EMAIL_FROM="Arya Pathshala <officialaryapathshala@gmail.com>"

# Security & Rate Limiting
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
